# ─── KEA Building Contracting website — environment variables ───
# Copy this file to `.env` (or `.env.local`) and fill in the real values.
# Never commit the real `.env` file.

# Public site address (used for canonical URLs, sitemap and structured data)
NEXT_PUBLIC_SITE_URL=https://construct.ae

# SMTP server used to send form submissions
# Examples — Microsoft 365: smtp.office365.com / 587 / false
#            Google Workspace: smtp.gmail.com / 465 / true (use an App Password)
#            Zoho: smtp.zoho.com / 465 / true
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@construct.ae
SMTP_PASS=your-smtp-password-or-app-password

# Sender shown on the emails (must be allowed to send from SMTP_USER's account)
MAIL_FROM="KEA Website <no-reply@construct.ae>"

# Recipients are fixed server-side in app/api/inquiry/route.js:
# project inquiries -> info@construct.ae; career profiles -> hr@construct.ae
